# Copy to .env.local for local development. Never commit your real API key.
MAILERSEND_API_TOKEN=
# Must be an address on a domain verified in MailerSend.
MAILERSEND_FROM_EMAIL=
# This is also the public contact address shown on the website.
ENQUIRY_TO_EMAIL=parv.sharmaa@outlook.com

# Local Qwen website assistant (Ollama must be running with qwen3:8b installed).
# For Vercel, set OLLAMA_BASE_URL to a secured, publicly reachable Ollama-compatible server.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Optional bearer token for a protected remote model server; keep it server-side.
OLLAMA_API_KEY=
